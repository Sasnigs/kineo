{
  "expo": {
    "name": "Kineo",
    "slug": "kineo-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kineo",
    "platforms": [
      "ios"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.kineo.expo.prototype",
      "deploymentTarget": "17.0",
      "supportsTablet": false,
      "usesAppleSignIn": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1E8"
        }
      ],
      "expo-sqlite",
      "expo-video",
      "expo-notifications",
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
